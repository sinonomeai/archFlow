# ---------------------------------------------------------------------------
# ArchFlow · 本地开发环境变量示例
# 复制为 .env 后按需修改；不要提交真实的 .env
# ---------------------------------------------------------------------------

# PostgreSQL (pgvector)
POSTGRES_USER=archflow
POSTGRES_PASSWORD=archflow
POSTGRES_DB=archflow
DATABASE_URL=postgresql://archflow:archflow@localhost:5432/archflow

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=archflow

# Auth / JWT
JWT_SECRET=change-me-in-local-dev

# LLM (原生 OpenAI SDK)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# 单次输出 token 上限；deepseek-flash 的 reasoning 也计入该预算
LLM_MAX_TOKENS=16384
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Web（写入 apps/web/.env）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# 在本地预览中启用真实模型，并在 apps/web/.env.local 配置模型变量
ARCHFLOW_PREVIEW_AGENT=0
# 默认使用正式 API。本地预览可在 apps/web/.env.local 设为 1
MOCK_API=0

# API
PORT=3001
